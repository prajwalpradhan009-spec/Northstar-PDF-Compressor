{
  "name": "northstar-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NorthStar API — PDF merge, Sharp image compression, MongoDB cookie-session auth.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node scripts/smoke-test.js",
    "test:gate": "node scripts/gate-check.js",
    "test:faq": "node scripts/faq-check.js"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "config",
      "controllers",
      "lib",
      "middleware",
      "models",
      "routes"
    ],
    "ext": "js,json",
    "delay": 400
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
