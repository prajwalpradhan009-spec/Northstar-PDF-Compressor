# ==========================================
# NORTHSTAR BACKEND — environment template
# Copy to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be committed.
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==========================================

NODE_ENV=development
PORT=5000

# ==========================================
# FRONTEND / CORS
# Comma-separated. FRONTEND_URL is added automatically.
# ==========================================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# ==========================================
# MONGODB
# Local:  mongodb://127.0.0.1:27017/northstar
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/northstar?retryWrites=true&w=majority
# Put local-only overrides in backend/.env.local; it loads before this file.
# ==========================================
MONGODB_URI=mongodb://127.0.0.1:27017/northstar

# ==========================================
# AUTHENTICATION
# ==========================================
JWT_SECRET=replace_with_a_long_random_secret
# Session lifetime in days (used for the HTTP-only auth cookie)
SESSION_MAX_AGE_DAYS=7

# ==========================================
# PASSWORD RESET EMAIL
# Resend uses HTTPS; verify the sender domain in Resend before using it.
# SMTP remains available for local development or other providers.
# ==========================================
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=NorthStar PDF Tools <no-reply@your-verified-domain.com>
# EMAIL_PROVIDER=smtp
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_google_app_password
OTP_EXPIRES_MINUTES=10
# Optional SMTP overrides for providers other than Gmail:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=Northstar PDF Tools <you@example.com>

# ==========================================
# UPLOAD LIMITS
# ==========================================
PDF_MAX_FILES=20
PDF_MAX_UPLOAD_MB=50
PDF_MAX_PAGES=1000
IMAGE_MAX_FILES=20
IMAGE_MAX_UPLOAD_MB=15
# Hard ceiling on a custom max-width/height the client may request
IMAGE_MAX_DIMENSION_PX=8000
