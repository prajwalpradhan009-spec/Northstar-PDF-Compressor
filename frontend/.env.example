# Frontend environment template.
# Copy to `.env` if you need to override defaults.
#
# The Vite dev server proxies /api to the backend (see vite.config.js), so in
# development you normally need NOTHING here — requests go to the same origin
# and the auth cookie stays first-party.
#
# Only set VITE_API_URL when the API lives on a different origin. Note that a
# cross-origin API requires the backend's ALLOWED_ORIGINS to include this
# origin AND the session to use SameSite=None; Secure over HTTPS.

# Absolute API base. Leave unset to use the dev proxy / same origin.
# VITE_API_URL=http://localhost:5000

# Where the Vite dev proxy forwards /api (defaults to http://localhost:5000)
VITE_PROXY_TARGET=http://localhost:5000
