# Frontend environment template.
# Copy to `.env` if you need to override defaults.
#
# The Vite dev server proxies /api to the backend (see vite.config.js), so in
# development you normally need NOTHING here — requests go to the same origin
# and the auth cookie stays first-party.
#
# Production uses a separate Render API service, so set VITE_API_URL in the
# frontend service's Render environment before building. The default Render
# frontend and API subdomains are same-site; the API still needs this frontend
# origin in FRONTEND_URL for credentialed CORS requests.

# Example only; replace with the actual API service URL.
# VITE_API_URL=https://YOUR-API-SERVICE.onrender.com

# Optional build-time UI limits. Keep these aligned with backend limits.
# VITE_PDF_MAX_FILES=20
# VITE_PDF_MAX_UPLOAD_MB=50
# VITE_IMAGE_MAX_FILES=20
# VITE_IMAGE_MAX_UPLOAD_MB=15

# Where the Vite dev proxy forwards /api (defaults to http://localhost:5000)
VITE_PROXY_TARGET=http://localhost:5000
